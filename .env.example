# Set environment variables before running locally; Compose reads this file after copying to .env.
API_BASE_URL=http://127.0.0.1:8000
DATA_DIR=data
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
HF_HOME=models/hf
# Optional Ollama backend. Enable only after downloading a suitable model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
TOKENIZERS_PARALLELISM=false

